# Byte-compiled
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution
dist/
build/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Vivado generated (don't track user's design files)
*.dcp
*.bit
*.vcd
*.log
*.jou
progress.json
*.wdb
xsim.dir/
.Xil/

# Exception: keep test fixtures and example outputs
!tests/fixtures/*.vcd
!tests/fixtures/*.log
!examples/**/outputs/*.vcd
!examples/**/outputs/*.log
!examples/**/outputs/*.rpt

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
